<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.icloud.fmfd.access</key>
	<true/>
	<key>com.apple.fmf</key>
	<true/>
	<!-- fmfd only *delivers* location updates (didReceiveLocation:) to clients
	     that also hold another Find My access entitlement; bare fmfd.access
	     connects and lists handles but never pushes fixes. -->
	<key>com.apple.icloud.findmydeviced.access</key>
	<true/>
	<!-- iOS 17+: friends moved to findmylocated. Messages holds these. -->
	<key>com.apple.findmy.findmylocate.friendshipservice</key>
	<true/>
	<key>com.apple.findmy.findmylocate.locationservice</key>
	<true/>
	<key>com.apple.findmy.findmylocate.settings</key>
	<true/>
	<!-- iOS 18 friend locations are end-to-end encrypted via searchpartyd.
	     Siri holds this to read them; untested whether it is what we lack. -->
	<key>com.apple.icloud.searchpartyd.securelocations.access</key>
	<true/>
	<!-- The rest copied from Find My.app's own set (iOS 18.6): the secure
	     locations service itself, plus the keychain groups that likely hold
	     the keys for decrypting friends' end-to-end encrypted locations.
	     fmfwatchd was SIGKILLed the instant the first location arrived. -->
	<key>com.apple.icloud.searchpartyd.securelocations</key>
	<true/>
	<key>com.apple.locationd.effective_bundle</key>
	<true/>
	<key>com.apple.private.security.storage.FindMy</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>com.apple.findmy</string>
		<string>com.apple.findmy.findmylocated</string>
		<string>com.apple.findmy.fmfcore.notbackedup</string>
		<string>com.apple.findmy.fmipcore.notbackedup</string>
	</array>
</dict>
</plist>
